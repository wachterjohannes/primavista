{
    "name": "primavista/ux-bundle",
    "description": "Primavista WYSIWYG editor for Symfony forms, built on Symfony UX and Stimulus. HTML in, HTML out.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony-ux",
        "wysiwyg",
        "editor",
        "form",
        "stimulus",
        "lexical"
    ],
    "homepage": "https://github.com/wachterjohannes/primavista",
    "require": {
        "php": ">=8.2",
        "symfony/config": "^7.4|^8.0",
        "symfony/dependency-injection": "^7.4|^8.0",
        "symfony/form": "^7.4|^8.0",
        "symfony/html-sanitizer": "^7.4|^8.0",
        "symfony/http-kernel": "^7.4|^8.0",
        "symfony/stimulus-bundle": "^2.9|^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "symfony/asset-mapper": "^7.4|^8.0",
        "symfony/framework-bundle": "^7.4|^8.0",
        "symfony/twig-bundle": "^7.4|^8.0",
        "symfony/validator": "^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Primavista\\UxBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Primavista\\UxBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Johannes Wachter",
            "email": "johannes@sulu.io"
        }
    ],
    "support": {
        "issues": "https://github.com/wachterjohannes/primavista/issues",
        "source": "https://github.com/wachterjohannes/primavista"
    }
}
