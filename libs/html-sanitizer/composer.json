{
    "name": "primavista/html-sanitizer",
    "description": "symfony/html-sanitizer configuration that keeps exactly the markup the Primavista editor emits.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "html-sanitizer",
        "wysiwyg",
        "editor",
        "xss",
        "lexical"
    ],
    "homepage": "https://github.com/wachterjohannes/primavista",
    "require": {
        "php": ">=8.2",
        "symfony/html-sanitizer": "^7.2|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Primavista\\HtmlSanitizer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Primavista\\HtmlSanitizer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Johannes Wachter",
            "email": "johannes@sulu.io"
        }
    ],
    "support": {
        "issues": "https://github.com/wachterjohannes/primavista/issues",
        "source": "https://github.com/wachterjohannes/primavista"
    }
}
