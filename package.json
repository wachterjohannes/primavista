{
  "name": "primavista",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './bundle/assets' --filter ./demo run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "build:pages": "pnpm --filter @primavista/pages build",
    "screencast:sulu": "node e2e/sulu-screencast.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "typescript": "^5.9.0",
    "@playwright/test": "^1.58.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wachterjohannes/primavista.git"
  },
  "license": "MIT"
}
