{
  "name": "primavista",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './bundles/ux-bundle/assets' --filter ./demo --filter ./examples/editorial-kit run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "size": "node scripts/size-check.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "api": "node scripts/api-report.mjs",
    "api:update": "node scripts/api-report.mjs --local",
    "e2e": "playwright test",
    "e2e:sulu": "playwright test -c playwright.sulu.config.ts",
    "e2e:install": "playwright install chromium firefox",
    "build:pages": "pnpm --filter @primavista/pages build",
    "screencast:sulu": "node e2e/sulu-screencast.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@microsoft/api-extractor": "^7.60.1",
    "@playwright/test": "^1.65.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wachterjohannes/primavista.git"
  },
  "license": "MIT"
}
