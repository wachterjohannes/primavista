{
  "name": "@primavista/sulu",
  "version": "0.1.0",
  "description": "Sulu flavour of the Primavista editor: sulu-link plugin, CKEditor-compatible preset, Sulu Admin theme and enter_mode helpers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./sulu.css": "./dist/sulu.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@primavista/core": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "lexical": "^0.53.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "wysiwyg",
    "editor",
    "sulu",
    "lexical",
    "ckeditor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wachterjohannes/primavista.git",
    "directory": "packages/sulu"
  },
  "homepage": "https://github.com/wachterjohannes/primavista",
  "bugs": "https://github.com/wachterjohannes/primavista/issues"
}
