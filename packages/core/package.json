{
  "name": "@primavista/core",
  "version": "0.1.0",
  "description": "Framework-agnostic WYSIWYG editor core built on Lexical. HTML in, HTML out.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./primavista.css": "./dist/primavista.css",
    "./package.json": "./package.json",
    "./themes/*": "./dist/themes/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lexical/history": "^0.51.0",
    "@lexical/html": "^0.51.0",
    "@lexical/link": "^0.51.0",
    "@lexical/list": "^0.51.0",
    "@lexical/rich-text": "^0.51.0",
    "@lexical/selection": "^0.51.0",
    "@lexical/table": "^0.51.0",
    "@lexical/utils": "^0.51.0",
    "lexical": "^0.51.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "wysiwyg",
    "editor",
    "lexical",
    "rich-text",
    "html"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wachterjohannes/primavista.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/wachterjohannes/primavista",
  "bugs": "https://github.com/wachterjohannes/primavista/issues"
}
