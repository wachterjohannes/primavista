{
  "name": "@primavista/core",
  "version": "0.1.0",
  "description": "Framework-agnostic WYSIWYG editor core built on Lexical. HTML in, HTML out.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./lexical": {
      "types": "./dist/lexical/index.d.ts",
      "import": "./dist/lexical/index.js",
      "require": "./dist/lexical/index.cjs"
    },
    "./lexical/clipboard": {
      "types": "./dist/lexical/clipboard.d.ts",
      "import": "./dist/lexical/clipboard.js",
      "require": "./dist/lexical/clipboard.cjs"
    },
    "./lexical/code-core": {
      "types": "./dist/lexical/code-core.d.ts",
      "import": "./dist/lexical/code-core.js",
      "require": "./dist/lexical/code-core.cjs"
    },
    "./lexical/history": {
      "types": "./dist/lexical/history.d.ts",
      "import": "./dist/lexical/history.js",
      "require": "./dist/lexical/history.cjs"
    },
    "./lexical/html": {
      "types": "./dist/lexical/html.d.ts",
      "import": "./dist/lexical/html.js",
      "require": "./dist/lexical/html.cjs"
    },
    "./lexical/link": {
      "types": "./dist/lexical/link.d.ts",
      "import": "./dist/lexical/link.js",
      "require": "./dist/lexical/link.cjs"
    },
    "./lexical/list": {
      "types": "./dist/lexical/list.d.ts",
      "import": "./dist/lexical/list.js",
      "require": "./dist/lexical/list.cjs"
    },
    "./lexical/markdown": {
      "types": "./dist/lexical/markdown.d.ts",
      "import": "./dist/lexical/markdown.js",
      "require": "./dist/lexical/markdown.cjs"
    },
    "./lexical/rich-text": {
      "types": "./dist/lexical/rich-text.d.ts",
      "import": "./dist/lexical/rich-text.js",
      "require": "./dist/lexical/rich-text.cjs"
    },
    "./lexical/selection": {
      "types": "./dist/lexical/selection.d.ts",
      "import": "./dist/lexical/selection.js",
      "require": "./dist/lexical/selection.cjs"
    },
    "./lexical/table": {
      "types": "./dist/lexical/table.d.ts",
      "import": "./dist/lexical/table.js",
      "require": "./dist/lexical/table.cjs"
    },
    "./lexical/utils": {
      "types": "./dist/lexical/utils.d.ts",
      "import": "./dist/lexical/utils.js",
      "require": "./dist/lexical/utils.cjs"
    },
    "./primavista.css": "./dist/primavista.css",
    "./package.json": "./package.json",
    "./themes/*": "./dist/themes/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lexical/clipboard": "^0.53.0",
    "@lexical/code-core": "^0.53.0",
    "@lexical/history": "^0.53.0",
    "@lexical/html": "^0.53.0",
    "@lexical/link": "^0.53.0",
    "@lexical/list": "^0.53.0",
    "@lexical/markdown": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@lexical/selection": "^0.53.0",
    "@lexical/table": "^0.53.0",
    "@lexical/utils": "^0.53.0",
    "lexical": "^0.53.0"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "wysiwyg",
    "editor",
    "lexical",
    "rich-text",
    "html"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wachterjohannes/primavista.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/wachterjohannes/primavista",
  "bugs": "https://github.com/wachterjohannes/primavista/issues"
}
